<h1>Admin Users</h1>
<div class="container">
  <table class="table table-striped table-hover">
    <thead>
    <tr>
      <td>id</td>
      <td>email</td>
      <td>genre</td>
    </tr>
    </thead>
    <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.email %></td>
        <td><%= user.genre %></td>
      </tr>
    <% end %>
    </tbody>
  </table>

  <%= paginate @users %>
</div>
